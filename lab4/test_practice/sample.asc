bits 32 
global start        
extern exit
import exit msvcrt.dll

; ----------------------------------------------------------------------
; Se dă enunțul de mai jos și codul sursă aferent soluției.
; Corectați tot ceea ce este necesar ca programul să funcționeze corect.
; Asigurați-vă că programul se asamblează fără erori și fără avertismente.
;-------------------------------------------------------------------------  
  
; signed representation
; a,b,c - byte 
; (a + a*b + a*b*c) / 100
                          
segment data use32 class=data

    a dw -1
    b dw -2
    c resb 10

; our code starts here
segment code use32 class=code
    start:
        mov CL, [a]
        cbw 
        mov BX, AX 
        mov AX, a
        mul byte [b] 
        adc EBX, EAX 
        mov AL, [a]
        mov CL, [b] 
        mul CX 
        mov CX, AX 
        mov DL, [c]
        mul CX 
        add AX, BX 
        idiv 100 
    
        ; exit(0)
        push    dword 0      ; push the parameter for exit onto the stack
        call    [exit]       ; call exit to terminate the program